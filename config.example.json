// ubersdr-ntp — example configuration.
//
// JSON with comments allowed. Copy to config.json and edit. Every field below
// is optional except "sources", and every value shown is the default unless the
// comment says otherwise.
//
//   ubersdr-ntp --config config.json
//
{
  // =====================================================================
  // PORTS
  //
  // Both services are here so you can find them. Neither has to be the
  // default.
  // =====================================================================
  "ntp": {
    // The NTP service. 123 is the default and is PRIVILEGED: either run as
    // root, grant the one capability
    //     sudo setcap 'cap_net_bind_service=+ep' ./ubersdr-ntp
    // or put AmbientCapabilities=CAP_NET_BIND_SERVICE in the systemd unit.
    //
    // Anything above 1023 needs no privilege and is fine for testing:
    //     ntpdate -q -u -p 3 127.0.0.1   (or with :PORT on a chrony client)
    "port": 123,

    // Which addresses to answer on. ["127.0.0.1"] to serve only this machine.
    "listen": ["0.0.0.0", "::"],

    // How long to keep answering after the last source loses lock, and how
    // fast the claimed accuracy decays while doing so. 15 ppm is NTP's own
    // assumed wander for an undisciplined clock. Past the limit it answers
    // stratum 0 with LI=3 — unsynchronised — which tells a client to look
    // elsewhere at once rather than making it wait for a timeout.
    "coast_seconds": 3600,
    "coast_drift_ppm": 15.0,

    "answer_when_unsynchronised": true,
    "honour_leap_warning": true,
    // Responses per second per client, 0 to disable.
    "rate_limit_per_client": 10.0

    // Where the crystal's fitted frequency is kept between runs -- ntpd's
    // driftfile, for ntpd's reason. Default: "drift" beside this file. "-"
    // disables it.
    //
    // The rate error is a property of a piece of hardware and does not change
    // over a restart, but measuring it takes ten minutes, and nothing can
    // borrow a rate that nothing has fitted yet. Until one exists every level
    // is carried forward as though the crystal were perfect, and because the
    // radio and NTP classes have different level windows they are biased by
    // different amounts -- so the difference between them, the one figure here
    // that checks the radio against anything, reads several ms out for a
    // quarter of an hour after every start. This is what removes that.
    // "drift_file": "/var/lib/ubersdr-ntp/drift"
  },

  "http": {
    // The read-only status service: the JSON API, the one-event-per-second
    // stream, and the page. Set "enabled": false, or --http-port 0, to turn it
    // off entirely.
    "enabled": true,
    "port": 1234,
    // All interfaces by default, like the NTP service. It serves no passwords,
    // but it does advertise which receivers this daemon uses — set
    // "127.0.0.1" to keep it on this machine. "::" binds IPv6 and IPv4 both.
    "listen": "0.0.0.0"
  },

  // =====================================================================
  // MQTT
  //
  // Published through the UberSDR receiver's own MQTT connection, by way of
  // its addon ingest port, and into Home Assistant if the receiver has
  // discovery on. Nothing to set: with no port to reach, or one that does not
  // recognise this machine as an installed addon, it stays dormant and asks
  // again every 30 s. The URL is only for a receiver container not called
  // "ubersdr", or a port moved from 6926; UBERSDR_INGEST_URL in the
  // environment overrides it. See "MQTT and Home Assistant" in the README.
  // =====================================================================
  "mqtt": {
    "enabled": true,
    "ingest_url": "http://ubersdr:6926"
  },

  // =====================================================================
  // THE TWO CLASSES OF SOURCE
  //
  // There are two kinds of reference here: the radio sources below, and
  // upstream NTP servers. They are not interchangeable, and the difference
  // is not about which is more accurate — a public NTP server very likely
  // beats this daemon's own radio estimate. It is about WHAT THEY FAIL TO.
  // The band dies every night and takes every receiver hearing the same
  // transmitter with it. The network dies for its own unrelated reasons.
  // Neither failure covers the other, and a clock meant to run unattended
  // for months wants both.
  //
  // So one class is the primary and the other the secondary.
  // =====================================================================
  "clock": {
    // Which class is trusted first. "radio" (the default) is the point of
    // this program: a stratum-1 reference that does not depend on the
    // network. "ntp" makes the upstreams primary and the radio the check on
    // them, which is the right way round on a machine where the network is
    // the reliable part and the radio is the interesting part.
    "primary": "radio",

    // What the OTHER class does while the primary is healthy.
    //
    //   "always"   Connected, and contributing. Both classes go into one
    //              intersection and one weighted mean. The most accurate
    //              arrangement, and any disagreement shows up as it happens.
    //
    //   "standby"  Connected and measured, but held out of the served time.
    //              The default, and the best trade for most installs:
    //              failover costs nothing because the standby is already
    //              warm, a broken standby is known about BEFORE it is
    //              needed, and the difference between the two classes is
    //              measured continuously — which is the only absolute
    //              reference this daemon has ever had for the constants
    //              every radio source shares. See "the delta" below.
    //
    //   "cold"     Not connected at all until the primary fails. The only
    //              mode that costs a remote receiver nothing while it is not
    //              needed — public UberSDR receivers cap concurrent sessions
    //              per address, usually at two — and the only one where
    //              failover is slow, because a radio source needs about five
    //              minutes to acquire a lock from nothing.
    "secondary": "standby",

    // How long the primary must have had nothing usable before the secondary
    // takes over, and how long it must be healthy again before it takes back.
    //
    // Deliberately different. Failing over is cheap and failing over late is
    // expensive. Failing BACK costs a step in the served time for no gain if
    // the primary is about to drop out again — and a decoder coming out of a
    // fade re-locks and loses it repeatedly for several minutes.
    "failover_after_seconds": 60,
    "failback_after_seconds": 300,

    // How many sources of each KIND must be usable — locked, fresh, and not
    // refused for disagreeing with the others — before that class counts as
    // healthy. Below it the class does not serve, and if it is the primary
    // the failover clock starts. Keyed by kind, not by role, so the figures
    // stay with the receivers and the servers whichever one is primary.
    //
    // 1 suits a single-receiver install. 2 radio sources makes the agreement
    // test load-bearing, which buys protection against one receiver producing
    // a CONFIDENT misread — a real failure mode here, because a deep fade
    // biases the same bits in every frame of the decoder's voter window and
    // no metric inside one decoder can catch it. An independent receiver can.
    "min_radio_sources": 1,
    "min_ntp_sources": 1
  },

  // =====================================================================
  // UPSTREAM NTP SERVERS
  //
  // As many as you like, exactly as with the radio sources below, and for
  // the same reason: each one is an independent candidate, so the same
  // agreement test that catches one receiver misdecoding also catches one
  // NTP server that has gone wrong.
  //
  // A bare string is a hostname. HOST:PORT works, and [v6addr]:PORT for an
  // IPv6 literal.
  //
  // THE DELTA. While both classes are measured at once — "always", and
  // "standby", which is what standby is for — the status page shows the
  // difference between them. That figure is worth understanding: every radio
  // source shares the same chain delay, codec delay and decoder edge bias, so
  // those terms cancel exactly in any comparison between receivers and NO
  // NUMBER OF RECEIVERS CAN MEASURE THEM. An NTP server does not share them.
  // So the difference is a direct reading of the radio delay model's absolute
  // error — the roughly 3 ms the README has only ever been able to estimate.
  // It is reported and never applied: a correction that made the radio agree
  // with the network by construction would destroy the only independent check
  // in the arrangement.
  // =====================================================================
  "ntp_defaults": {
    // Seconds between polls. 64 is NTP's own default and what a public server
    // expects. Anything under 16 is rude to a server you do not own, and the
    // pool's terms of service say so. The offset estimator's windows scale off
    // this, so changing it needs nothing else changed with it.
    "poll_seconds": 64,

    // A short burst on the first poll, and whenever a cold peer is brought up.
    // One sample is not a measurement, and a fallback that takes six minutes
    // to become usable arrives after the outage it was for.
    "iburst": true,

    // Refuse a server whose OWN root distance is worse than this: it is
    // telling you, in the packet, how well it knows the time.
    "max_root_distance_ms": 500,

    // The furthest up the tree to follow. Stratum 16 is unsynchronised and is
    // always refused; this is about how much accumulated path to accept.
    "max_stratum": 15
  },

  "ntp_sources": [
    // A router or a server on your own network: the lowest delay available,
    // and the one worth weighting up. Uncomment and put a comma after the
    // entry below it.
    // { "server": "192.168.1.1", "poll_seconds": 32, "weight": 2.0 },

    // More public servers. Three or more and the agreement test has something
    // to work with, so one of them going wrong cannot move the clock.
    //
    // Prefer a NAMED server with a fixed address over a pool entry. A pool
    // hands back a different machine on each DNS refresh, and a changed
    // address clears this peer's eight-sample clock filter (NtpPeer::resolve);
    // at a 64 second poll that register takes eight and a half minutes to
    // refill, so a peer that moves every few minutes never settles and
    // contributes noise rather than a second opinion. Enable these only if
    // nothing steadier is reachable.
    // "0.pool.ntp.org",
    // "1.pool.ntp.org",

    // Cloudflare's anycast time service, ON BY DEFAULT.
    //
    // A reasonable thing to ship enabled: anycast, no registration, no
    // rate-limit surprises, and it costs one packet a minute. With the
    // secondary on "standby" it never touches the served time while the radio
    // is healthy — it is there to notice the radio going wrong, to measure the
    // delay model against something that does not share its constants, and to
    // take over when the band dies.
    //
    // Delete this line if the machine must talk to nothing but the receivers.
    // That is a real requirement, and it is one line.
    "time.cloudflare.com"
  ],

  // =====================================================================
  // SOURCES — the receivers, and what each listens to.
  //
  // More than one because HF propagation makes any single frequency
  // unreliable: 10 MHz from Fort Collins is excellent in the afternoon and
  // gone at 3am, 5 MHz is the other way round, and a receiver on another
  // continent hears a different subset again.
  //
  // This array is the RADIO class; upstream NTP servers are "ntp_sources"
  // above. Every setting here is per source, passwords included: several
  // receivers with different bypass passwords is an ordinary arrangement, and
  // "defaults" only supplies what a source does not set for itself.
  //
  // Note that public receivers usually cap concurrent sessions per IP — two
  // is common — so several frequencies on ONE receiver often is not
  // possible. Several receivers is better anyway: it decorrelates the
  // propagation path as well as the frequency.
  // =====================================================================
  "defaults": {
    // "pcm-v4" (default) is the predictive lossless codec, asked for at full
    // quality (min_margin=0, as DCF77's IQ always is): no codec delay at all,
    // at roughly four times the bandwidth of Opus. "opus" is about 24 kbps and
    // adds a constant ~8 ms that the delay model accounts for -- the choice for
    // a receiver on a slow or metered link.
    "format": "pcm-v4",
    "verify_tls": true,
    "auto_delay": true
  },

  "sources": [
    {
      // A receiver on the local network, found by mDNS. The lowest-latency
      // and best-calibrated case: no internet path in the budget.
      "name": "local-10",
      "url": "http://ubersdr.local:8080",

      // The TRANSMITTER's carrier. The dial is derived as 1 kHz below it,
      // which is the tuning WWV, WWVH and WWVB all want — it puts the carrier
      // at 1000 Hz audio in USB. DO NOT subtract the kilohertz yourself.
      "carrier_hz": 10000000,

      // The receiver's bypass password, if it has one. Worth having: a
      // bypassed session has no time limit, and a session the server kicks
      // costs about four minutes of clean signal to re-acquire a lock.
      "password": "",

      // Anything the delay model cannot see, in milliseconds. The receiver's
      // own delay (radiod to the WebSocket) is the same on every UberSDR
      // instance and already built in, as is the decoder's edge bias.
      //
      // Leave at 0 unless this one source disagrees with a reference clock
      // you trust for a reason of its own. Getting it wrong biases the served
      // time by exactly the amount you got wrong.
      "extra_delay_ms": 0.0,

      // Relative confidence in the combine. A receiver you know to be worse
      // can be kept and weighted down rather than removed.
      "weight": 1.0,

      "enabled": true
    },
    {
      // A second frequency on the same receiver. Two independent propagation
      // paths through one receiver: the best available check that the decode
      // is right, and in testing two such sources agreed to well under a
      // millisecond on the raw offset.
      "name": "local-15",
      "url": "http://ubersdr.local:8080",
      "carrier_hz": 15000000
    },
    {
      // A remote receiver, for when the local one cannot hear the station.
      // Replace the host with a receiver you have permission to use — this is
      // a long-lived session that occupies one of its listener slots.
      "name": "remote-10",
      "url": "https://sdr.example.org",
      "carrier_hz": 10000000,
      "enabled": false
    }

    // WWVB, for a receiver in range of its 60 kHz groundwave. Chosen
    // automatically for any dial below 1 MHz — it is a genuinely different
    // decoder, not a setting:
    // { "name": "wwvb", "url": "http://ubersdr.local:8080", "carrier_hz": 60000 }

    // DCF77, for a receiver in Europe. The German time signal: 50 kW on
    // 77.5 kHz longwave from Mainflingen, near Frankfurt, run by PTB. Its
    // groundwave carries reliably to about 2000 km, which is most of Europe --
    // the UK and Ireland, Scandinavia, Iberia, Italy, eastern Europe -- and it
    // is often heard further at night. Longwave does not die at night the way
    // HF does, which makes it a good partner for a WWV source. The receiver has
    // to cover LF: an RX888 or a KiwiSDR does, many HF-only SDRs stop above it,
    // and a station with QRM at LF will do better elsewhere.
    //
    // Recognised by its carrier, exactly, and tuned ON it in IQ mode rather
    // than 1 kHz below in USB: its phase modulation is what times the second
    // to tens of microseconds, and an audio channel keeps no phase. IQ is
    // always lossless, so "format" is ignored. Its amplitude modulation is
    // decoded alongside as the check and the fallback (see "DCF77" in the
    // README):
    // { "name": "dcf77", "url": "http://ubersdr.local:8080", "carrier_hz": 77500 }

    // WWV's two extra outlets. 20 MHz is WWV only; 25 MHz is an experimental
    // broadcast — real, but intermittent and lower power:
    // { "name": "local-20", "url": "http://ubersdr.local:8080", "carrier_hz": 20000000 }
  ],

  // =====================================================================
  // LOGGING
  //
  // With a file set, the same lines go to stderr and to the file, PLUS a
  // detailed per-source status block every status_interval_seconds — which is
  // how you see what each source is doing when this runs in the background
  // with no terminal.
  //
  // SIGHUP reopens the file, for logrotate. SIGUSR1 writes a block at once.
  // =====================================================================
  "log": {
    "file": "",
    "level": "info",
    "stderr": true,
    "status_interval_seconds": 30
  }
}
