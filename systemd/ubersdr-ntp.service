# Install to /etc/systemd/system/ubersdr-ntp.service, put the configuration at
# /etc/ubersdr-ntp.json (root-owned, mode 0600 -- it holds receiver passwords),
# then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ubersdr-ntp
#   journalctl -u ubersdr-ntp -f
#
# If the configuration sets log.file, the detailed per-source status blocks go
# there and the journal keeps the one-line records. Without it, everything goes
# to the journal. The only writable place is the logs directory below, so the
# file must be under it:
#
#   "log": { "file": "/var/log/ubersdr-ntp/ubersdr-ntp.log" }
#
# Needs systemd 247 or later, for LoadCredential= (Ubuntu 22.04, Debian 11 and
# newer). On an older systemd, create a system user, drop DynamicUser= and
# LoadCredential=, add User=ubersdr-ntp and Group=ubersdr-ntp, make the config
# root:ubersdr-ntp 0640, and point ExecStart at /etc/ubersdr-ntp.json.

[Unit]
Description=NTP server disciplined by WWV/WWVH/WWVB over UberSDR
Documentation=https://github.com/madpsy/ubersdr-ntp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The configuration is handed over as a credential rather than read in place.
# A dynamic user has no fixed UID to own or be granted the file, so reading it
# directly would need it world-readable, passwords and all. systemd reads it
# as root at start and exposes a private copy only this service's UID can
# read. The file can therefore stay 0600 root.
LoadCredential=config:/etc/ubersdr-ntp.json
ExecStart=/usr/local/bin/ubersdr-ntp --config ${CREDENTIALS_DIRECTORY}/config
# SIGHUP reopens the log file, which is what logrotate wants.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Port 123 is privileged, and this is the only privilege needed. Granting just
# the capability is why the service can still run as an unprivileged dynamic
# user. Drop both lines if ntp.port is above 1023.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The NTP reply threads run SCHED_FIFO at ntp.realtime_priority (default 10):
# the transmit timestamp is read just before the send, and a thread preempted in
# between hands the client that delay as offset. The limit is what permits it,
# with no capability; they sleep until a request and use microseconds on it, and
# the decoders stay at normal priority. So RestrictRealtime= is not set here.
# Memory is locked (unlimited MEMLOCK) so no page fault lands in that gap either.
LimitRTPRIO=10
LimitMEMLOCK=infinity

# /var/log/ubersdr-ntp, created and chowned to the dynamic UID on every start.
# ReadWritePaths= is no substitute: it lifts ProtectSystem= for the path but
# does not change its owner, and a dynamic UID cannot be given ownership of a
# directory in advance -- so log.file could not be opened and the daemon would
# exit, restart and fail again every RestartSec.
LogsDirectory=ubersdr-ntp

# It reads one config file, opens outbound TLS connections, binds two sockets
# and writes one log. Nothing else, so nothing else is permitted.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
# The 1PPS output (pps in the configuration) needs its serial port. To use it,
# replace PrivateDevices=yes with these three, naming the port:
#   PrivateDevices=no
#   DeviceAllow=/dev/ttyS0 rw
#   SupplementaryGroups=dialout
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
